{
  "$comment": "The single source of the look. Edit values here, run `node design/build.mjs`, commit the two generated files. Colours are 6-digit hex. Names are fixed by docs/CONTRACT.md section 11; add new ones in the contract first.",
  "color": {
    "bg":            { "light": "#faf8f5", "dark": "#141311" },
    "surface":       { "light": "#f2eee8", "dark": "#1c1a17" },
    "surface-raised":{ "light": "#ffffff", "dark": "#26231f" },
    "text":          { "light": "#1f1c18", "dark": "#efeae2" },
    "text-muted":    { "light": "#6b645b", "dark": "#a29a8e" },
    "border":        { "light": "#ddd6cb", "dark": "#36322c" },
    "accent":        { "light": "#2b7a68", "dark": "#5fb89f" },
    "accent-text":   { "light": "#ffffff", "dark": "#0f2620" },
    "danger":        { "light": "#b83a2e", "dark": "#ef6b5c" },
    "success":       { "light": "#2c7a4b", "dark": "#5fc58a" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 20, "pill": 999 },
  "font": {
    "family": "ui-rounded, -apple-system, BlinkMacSystemFont, \"SF Pro Rounded\", \"Segoe UI\", Roboto, system-ui, sans-serif",
    "familyMono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "size": {
      "caption":  { "px": 12, "weight": "regular" },
      "body":     { "px": 15, "weight": "regular" },
      "headline": { "px": 17, "weight": "semibold" },
      "title":    { "px": 22, "weight": "semibold" },
      "large":    { "px": 30, "weight": "semibold" }
    }
  },
  "motion": {
    "fast": 0.15,
    "base": 0.25,
    "slow": 0.4,
    "spring": { "response": 0.35, "damping": 0.8 }
  }
}
