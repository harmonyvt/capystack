{
  "name": "capystack-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "dry-run": "npm run build && cd deploy && cf deploy --dry-run",
    "deploy": "npm run build && cd deploy && cf deploy",
    "postinstall": "node scripts/link-deploy.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "cf": "1.0.0-beta.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "posthog-js": "^1.450.0"
  }
}
